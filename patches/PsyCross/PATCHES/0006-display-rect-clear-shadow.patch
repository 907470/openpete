diff --git a/include/PsyX/PsyX_render.h b/include/PsyX/PsyX_render.h
index dafca55..8ae5796 100644
--- a/include/PsyX/PsyX_render.h
+++ b/include/PsyX/PsyX_render.h
@@ -207,6 +207,20 @@ extern void			GR_SetWireframe(int enable);
 extern void			GR_DestroyTexture(TextureID texture);
 extern void			GR_Clear(int x, int y, int w, int h, unsigned char r, unsigned char g, unsigned char b);
 extern void			GR_ClearVRAM(int x, int y, int w, int h, unsigned char r, unsigned char g, unsigned char b);
+
+/* Display-rect clear shadow: PsyCross is direct-rasterize-to-GL with no
+ * VRAM-as-FBO intermediary, so the GL backbuffer rotates to driver-stale
+ * content on every SwapWindow. PSX scanout has no implicit clear — it
+ * just reads VRAM at activeDispEnv.disp every vblank — so we shadow the
+ * most recent solid-color clear that touched the display rect and
+ * replay it at every BeginScene, regardless of the drawenv's isbg.
+ * Without this, an isbg=0 drawenv (e.g. Spyro's loading transitions)
+ * smears prior frames' pixels into the new frame. */
+extern void			PsyX_NoteClearForDispRect(short x, short y, short w, short h,
+											  unsigned char r, unsigned char g, unsigned char b);
+extern void			PsyX_InvalidateDispRectClearShadow(void);
+extern void			PsyX_ReplayDispRectClearShadow(void);
+
 extern void			GR_UpdateVertexBuffer(const GrVertex* vertices, int count);
 extern void			GR_DrawTriangles(int start_vertex, int triangles);
 
