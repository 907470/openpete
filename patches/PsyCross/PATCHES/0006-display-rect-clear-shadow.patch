diff --git a/src/render/PsyX_render.cpp b/src/render/PsyX_render.cpp
index df2fe5b..f911516 100644
--- a/src/render/PsyX_render.cpp
+++ b/src/render/PsyX_render.cpp
@@ -1324,6 +1324,41 @@ void GR_Clear(int x, int y, int w, int h, unsigned char r, unsigned char g, unsi
 #endif
 }
 
+/* Shadow of the most recent solid-color clear that touched the active
+ * display rect. See PsyX_render.h for the rationale. */
+static struct {
+	int     valid;
+	short   x, y, w, h;
+	u_char  r, g, b;
+} g_dispClearShadow = { 0, 0, 0, 0, 0, 0, 0, 0 };
+
+void PsyX_NoteClearForDispRect(short x, short y, short w, short h,
+							   unsigned char r, unsigned char g, unsigned char b)
+{
+	g_dispClearShadow.valid = 1;
+	g_dispClearShadow.x = x;
+	g_dispClearShadow.y = y;
+	g_dispClearShadow.w = w;
+	g_dispClearShadow.h = h;
+	g_dispClearShadow.r = r;
+	g_dispClearShadow.g = g;
+	g_dispClearShadow.b = b;
+}
+
+void PsyX_InvalidateDispRectClearShadow(void)
+{
+	g_dispClearShadow.valid = 0;
+}
+
+void PsyX_ReplayDispRectClearShadow(void)
+{
+	if (!g_dispClearShadow.valid)
+		return;
+	GR_Clear(g_dispClearShadow.x, g_dispClearShadow.y,
+			 g_dispClearShadow.w, g_dispClearShadow.h,
+			 g_dispClearShadow.r, g_dispClearShadow.g, g_dispClearShadow.b);
+}
+
