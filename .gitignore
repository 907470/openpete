build/
.cache/
compile_commands.json
*.o
*.obj
*.swp
.DS_Store
games/*/generated/
# Auto-generated from spyro-1/build/psx.map by tools/build_manifest.py;
# native.toml is hand-curated and is checked in.
games/*/manifest/symbols.toml
games/*/manifest/globals.toml
tools/__pycache__/
tools/rewrite/__pycache__/
third_party/psxrecomp/build/
third_party/psxrecomp/build-mingw/

# Run artefacts (PsyX log, screenshot dump path).
Spyro the Dragon.log
SCREENSHOT.BMP
screenshot*.png
screenshot*.bmp

# Local tooling not part of the build (cloned reference emulators, scratch
# binaries, traces). Kept around for the GTE trace-vs-PsyCross workflow.
.tools/

# Cross-built static FFmpeg for windows-mingw --record (see scripts/setup_mingw_ffmpeg.sh)
third_party/ffmpeg-mingw/
third_party/ffmpeg-mingw-build/
/dist/

# Stray disc-library from running an exe at the repo root (dist runtime dir).
/library/

# Throwaway clean launcher dir for demoing the splash.
/launcher-demo/

# Mod build artifacts (compiled on load by the mod loader)
mods/*/.build/
# Per-mod persistent data (the data-dir service; e.g. ghost-lite recordings)
mods/*/data/
# Derived-locally assets (extract_*.py output — never shipped/committed)
mods/*/assets/s3/
mods-attic/*/assets/s3/
# Texel strip convert_chests.py derives from the same disc.
mods/spyro3/assets/textures/own/
# S3 samples the converters decode to WAV for the sfx pack (same disc).
mods/spyro3/assets/sfx/

# Generated mod-docs reference pages (tools/gen_mod_docs.py output)
docs/modding/pages/reference/
docs/modding/pages/imgui.md
# Generated codebase reference pages (tools/gen_code_docs.py output)
docs/src/developer/reference/

# Custom levels: derived locally from the xdelta + your own disc (tools/derive.py)
mods/grim-garden/assets/
mods/spyro15-cliff-town/assets/

# In-game fill-tag pick sessions (P-key inspector). Working files: fold them
# into tests/freecam/fill-tags.verdicts with scripts/fill-tags-apply.py, which
# is what gets committed.
fill-tags.session
tests/freecam/__pycache__/

# ctest scratch, written when ctest runs from the source dir rather than
# the build dir (a wrong-cwd invocation still leaves this behind).
Testing/
# crash3-models: pack + atlases are converted from the disc (tools/crash3/convert.py)
mods/crash3-models/assets/
/notes/

# PSX RAM dumps never enter the repo (scripts/fences/no-ram-dump.py bans them
# by content as well; these names are the diagnostic-output spellings).
*.ram
*.seed.ram
*.seed.cpu
ram-*.bin
*-ram-dump*
!*-ram-dump*.lua
!*-ram-dump*.py
# Hang-watchdog dumps (hang-ram.bin holds guest RAM) and numpy arrays the
# capture analysis writes beside its images.
hang-*.bin
*.npy

# Oracle goldens are derived from the disc and the pinned DuckStation fork
# (games/<game>/oracle.conf); the gate captures them on first run.
tests/golden/*/psxtrace-*

# Golden images are generated: a golden's verdict is its committed digest
# manifest, and the images live in the per-user store
# (scripts/presentation-blessed.py). The identity baselines stay committed.
# scripts/fences/golden-png-guard.py refuses a staged image here.
tests/golden/**/*.png
