{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-debug",
      "displayName": "Linux native (Debug, hybrid decomp mode)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_PROJECT_openpete_INCLUDE": "${sourceDir}/cmake/presets/linux-debug.cmake"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux native (RelWithDebInfo)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_PROJECT_openpete_INCLUDE": "${sourceDir}/cmake/presets/linux-release.cmake"
      }
    },
    {
      "name": "windows-mingw",
      "displayName": "Windows x64 via MinGW (cross from Linux/WSL2)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-mingw",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw-w64.cmake",
      "cacheVariables": {
        "CMAKE_PROJECT_openpete_INCLUDE": "${sourceDir}/cmake/presets/windows-mingw.cmake"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows native MSVC (placeholder; not validated this phase)",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/windows-msvc",
      "architecture": {
        "value": "x64"
      },
      "cacheVariables": {
        "CMAKE_PROJECT_openpete_INCLUDE": "${sourceDir}/cmake/presets/windows-msvc.cmake"
      }
    },
    {
      "name": "macos-universal",
      "displayName": "macOS universal (placeholder; not validated this phase)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-universal",
      "cacheVariables": {
        "CMAKE_PROJECT_openpete_INCLUDE": "${sourceDir}/cmake/presets/macos-universal.cmake",
        "CMAKE_OSX_ARCHITECTURES": "x86_64;arm64"
      }
    },
    {
      "name": "ios-arm64",
      "displayName": "iOS device arm64 (experimental; engine only for now)",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/ios-arm64",
      "toolchainFile": "${sourceDir}/cmake/toolchains/ios.cmake",
      "cacheVariables": {
        "CMAKE_PROJECT_openpete_INCLUDE": "${sourceDir}/cmake/presets/ios-arm64.cmake"
      }
    },
    {
      "name": "wasm",
      "displayName": "WebAssembly via Emscripten (browser)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_PROJECT_openpete_INCLUDE": "${sourceDir}/cmake/presets/wasm.cmake"
      }
    },
    {
      "name": "linux-release-shared",
      "displayName": "linux-release + shared recomp module (distribution D1)",
      "inherits": "linux-release",
      "binaryDir": "${sourceDir}/build/linux-release-shared",
      "cacheVariables": {
        "CMAKE_PROJECT_openpete_INCLUDE": "${sourceDir}/cmake/presets/linux-release-shared.cmake"
      }
    },
    {
      "name": "linux-release-container",
      "displayName": "linux-release inside the capture image (tests/harness/linux-capture.Dockerfile)",
      "inherits": "linux-release",
      "binaryDir": "${sourceDir}/build/linux-release-container",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/gcc-11",
        "CMAKE_CXX_COMPILER": "/usr/bin/g++-11"
      }
    },
    {
      "name": "windows-mingw-shared",
      "displayName": "windows-mingw + shared recomp module (distribution D1)",
      "inherits": "windows-mingw",
      "binaryDir": "${sourceDir}/build/windows-mingw-shared",
      "cacheVariables": {
        "CMAKE_PROJECT_openpete_INCLUDE": "${sourceDir}/cmake/presets/windows-mingw-shared.cmake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "windows-mingw",
      "configurePreset": "windows-mingw"
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc"
    },
    {
      "name": "macos-universal",
      "configurePreset": "macos-universal"
    },
    {
      "name": "ios-arm64",
      "configurePreset": "ios-arm64"
    },
    {
      "name": "wasm",
      "configurePreset": "wasm"
    },
    {
      "name": "linux-release-shared",
      "configurePreset": "linux-release-shared"
    },
    {
      "name": "linux-release-container",
      "configurePreset": "linux-release-container"
    },
    {
      "name": "windows-mingw-shared",
      "configurePreset": "windows-mingw-shared"
    }
  ]
}
