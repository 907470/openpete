{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-debug",
      "displayName": "Linux native (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux native (RelWithDebInfo)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "OPENPETE_SKIP_DECOMP": "ON"
      }
    },
    {
      "name": "windows-mingw",
      "displayName": "Windows x64 via MinGW (cross from Linux/WSL2)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-mingw",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw-w64.cmake",
      "cacheVariables": {
        "OPENPETE_SKIP_DECOMP": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS": "-march=x86-64-v3",
        "CMAKE_CXX_FLAGS": "-march=x86-64-v3"
      }
    },
    {
      "name": "windows-mingw-opt",
      "displayName": "Windows x64 MinGW + LTO, portable -march=x86-64-v3 (distributable release build; slow link)",
      "inherits": "windows-mingw",
      "binaryDir": "${sourceDir}/build/windows-mingw-opt",
      "cacheVariables": {
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "OPENPETE_HIDE_DEBUG_FLAGS": "ON"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows native MSVC (placeholder; not validated this phase)",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/windows-msvc",
      "architecture": {
        "value": "x64"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "macos-universal",
      "displayName": "macOS universal (placeholder; not validated this phase)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-universal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "x86_64;arm64"
      }
    },
    {
      "name": "wasm",
      "displayName": "WebAssembly via Emscripten (browser)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OPENPETE_SKIP_DECOMP": "ON",
        "OPENPETE_BUILD_PCSX_REDUX_GTE": "OFF",
        "OPENPETE_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "linux-release-shared",
      "displayName": "linux-release + shared recomp module (distribution D1)",
      "inherits": "linux-release",
      "binaryDir": "${sourceDir}/build/linux-release-shared",
      "cacheVariables": {
        "OPENPETE_RECOMP_LINKAGE": "shared",
        "OPENPETE_ROM_FREE_ICON": "ON",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "OPENPETE_ENABLE_RECORD": "OFF"
      }
    },
    {
      "name": "windows-mingw-shared",
      "displayName": "windows-mingw + shared recomp module (distribution D1)",
      "inherits": "windows-mingw",
      "binaryDir": "${sourceDir}/build/windows-mingw-shared",
      "cacheVariables": {
        "OPENPETE_RECOMP_LINKAGE": "shared",
        "OPENPETE_STAGE_MOD_DLLS": "OFF",
        "OPENPETE_ROM_FREE_ICON": "ON",
        "OPENPETE_ENABLE_RECORD": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "windows-mingw",
      "configurePreset": "windows-mingw"
    },
    {
      "name": "windows-mingw-opt",
      "configurePreset": "windows-mingw-opt"
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc"
    },
    {
      "name": "macos-universal",
      "configurePreset": "macos-universal"
    },
    {
      "name": "wasm",
      "configurePreset": "wasm"
    },
    {
      "name": "linux-release-shared",
      "configurePreset": "linux-release-shared"
    },
    {
      "name": "windows-mingw-shared",
      "configurePreset": "windows-mingw-shared"
    }
  ]
}