#!/usr/bin/env python3
"""pre-push: refuse a push while the history-rewrite freeze holds, and any
push that would publish a commit of the pre-rewrite history.

Installed as githooks/pre-push in openpete (core.hooksPath = githooks, so
every worktree whose checkout holds the file runs it) and copied to
.git/modules/third_party/PsyCross/hooks/pre-push in the fork module (shared
by the module's linked worktrees).

Freeze: while the marker exists (OPENPETE_FREEZE_MARKER, default
~/.local/share/openpete/provenance/FREEZE), every push is refused, whatever
the remote's name.
Old ids: armed by the repository's config `openpete.oldIdMaps` (a file that
lists commit-map paths, one per line; OPENPETE_OLD_ID_MAPS overrides). Each
map's old-id column (rows whose old and new ids differ) is the set of
pre-rewrite commits; a pushed ref whose new commits (`rev-list <local> --not
<remote's old value>`, or its whole history for a new remote ref) include
one is refused. Once armed, an unreadable list or map refuses every push:
the hook does not fall back to unarmed. Unset (before the rewrite) only the
freeze applies.
git passes `<local ref> <local sha> <remote ref> <remote sha>` per line on
stdin. Exit 1 refuses the push."""
import os, subprocess, sys

ZERO = "0" * 40
marker = os.environ.get("OPENPETE_FREEZE_MARKER") or os.path.expanduser("~/.local/share/openpete/provenance/FREEZE")
if os.path.exists(marker):
    sys.stderr.write("pre-push: history-rewrite freeze in force (%s): %s\n" % (
        marker, open(marker).readline().strip()))
    sys.exit(1)
lst = os.environ.get("OPENPETE_OLD_ID_MAPS") or subprocess.run(
    ["git", "config", "--get", "openpete.oldIdMaps"], capture_output=True, text=True).stdout.strip()
if not lst:
    sys.exit(0)
old = set()
try:
    maps = [l.strip() for l in open(os.path.expanduser(lst)) if l.strip() and not l.startswith("#")]
    if not maps:
        raise OSError("empty list")
    for m in maps:
        with open(m) as fh:
            for line in fh:
                f = line.split()
                if len(f) == 2 and len(f[0]) == 40 and f[0] != f[1] and f[0] != "old":
                    old.add(f[0])
except OSError as e:
    sys.stderr.write("pre-push: old-id guard armed (%s) but unreadable: %s; refusing\n" % (lst, e))
    sys.exit(1)
bad = []
for line in sys.stdin:
    f = line.split()
    if len(f) != 4 or f[1] == ZERO:
        continue
    local, remote = f[1], f[3]
    args = ["git", "rev-list", local]
    if remote != ZERO and subprocess.run(["git", "cat-file", "-e", remote + "^{commit}"], capture_output=True).returncode == 0:
        args += ["--not", remote]
    commits = subprocess.run(args, capture_output=True, text=True, check=True).stdout.split()
    hit = [c for c in commits if c in old]
    if hit:
        bad.append("%s -> %s: %d pre-rewrite commit(s), first %s" % (f[0], f[2], len(hit), hit[0]))
if bad:
    sys.stderr.write("pre-push: refusing to publish pre-rewrite history (maps: %s):\n  %s\n" % (", ".join(maps), "\n  ".join(bad)))
    sys.exit(1)
sys.exit(0)
