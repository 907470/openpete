 {
     if (!s_pt.thr) return;
-    SDL_LockMutex(s_pt.mx);
     if (on) {
         if (!s_pt.active) {
             s_pt.active = 1;
             /* Never 0, which the thread's served number starts at. */
             if (++s_pt.activation == 0) s_pt.activation = 1;
             SDL_SignalCondition(s_pt.cv);
         }
-        SDL_UnlockMutex(s_pt.mx);
         return;
     }
+    SDL_LockMutex(s_pt.mx);
     if (s_pt.active) {
         s_pt.active = 0;
         SDL_SignalCondition(s_pt.cv);
