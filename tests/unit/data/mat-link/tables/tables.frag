/** @brief Recolour the base through the four tables, keyed by its quantised channels. */
vec4 op_material(vec4 base)
{
    uint r = uint(clamp(base.r, 0.0, 1.0) * 255.0 + 0.5);
    uint g = uint(clamp(base.g, 0.0, 1.0) * 255.0 + 0.5);
    uint b = uint(clamp(base.b, 0.0, 1.0) * 255.0 + 0.5);
    uint v = k_lut[(r * 2u + uint(k_small[g & 15u])) & 511u];
    vec4 p = k_pal[(v >> 8) % 96u];
    float ramp = float(g_ramp[(b + (v & 255u)) % 300u] & 255u) / 255.0;
    float k = clamp(mix_amount.a, 0.0, 1.0);
    return vec4(mix(base.rgb, p.rgb * (0.5 + 0.5 * ramp), k), base.a);
}
