# freecam-corpus.manifest - (level, pose) tuples for the Spyro 3 debug-freecam
# golden. Same row form as games/spyro-1/corpus/freecam-corpus.manifest:
#   <level>[:<area>] | pos=(x, y, z) yaw=Y pitch=P | [start]
# Each row is a reported defect; the class it belongs to is named on
# the row's comment.
# animated terrain holds its tick pose on intermediate presents
sunrise_spring | pos=(45559, 29220, 16378) yaw=1474 pitch=379
# animated terrain draws through the portal preview
sunrise_spring | pos=(26088, 46942, 20298) yaw=1150 pitch=-84
# butterfly bottles (simple kind) draw opaque
sunrise_spring | pos=(49988, 33610, 17123) yaw=1083 pitch=213
# metal vases (simple kind) draw through a wall
sunrise_spring | pos=(102255, 56733, 22972) yaw=-1891 pitch=6
# terrain depth ordering
sunny_villa | pos=(79168, 34297, 14796) yaw=867 pitch=197
# sub-level portal depth
cloud_spires | pos=(26935, 50493, 13187) yaw=-1351 pitch=84
# moby without its specular pass
cloud_spires | pos=(61927, 44074, 8510) yaw=1029 pitch=10
# locked chest without its specular pass
molten_crater | pos=(60294, 100033, 12024) yaw=791 pitch=212
# terrain depth ordering
seashell_shore | pos=(70859, 80778, 15700) yaw=-1802 pitch=222
# inside the terrain the native and guest renders differ; reporter suspects
# the back-face rule
sunrise_spring | pos=(93293, 45901, 25017) yaw=-1494 pitch=-24
# egg thief draws without its colour
midday_gardens | pos=(64750, 54918, 9705) yaw=380 pitch=207
# with interpolation the world flickers at the tick cadence; the vases behind the
# sign flicker with it (the other vase does not)
spooky_swamp | pos=(61666, 72370, 9835) yaw=167 pitch=33
# --lod extended: mobys take the extended model rule but keep the stock distance
# cull, so distant mobys vanish (the lodext tiles carry the defect)
sunrise_spring | pos=(59755, 4990, 36743) yaw=1480 pitch=354
# --lod extended: distant mobys keep the low-poly model and the distance fade
# (50 of 54 simple records low-poly at the pose; the lodext tiles carry the defect)
sunrise_spring | pos=(50900, 12500, 26900) yaw=1480 pitch=354
# Widescreen moby cull: the basket on the right of the frame is visible at
# 16:9 but is culled early; blessed pre-fix.
sunrise_spring | pos=(39482, 20225, 17997) yaw=-201 pitch=-30
# terrain texture tier: the wall's higher-quality texture repeats four times
# where the lower one drew whole; under --lod extended the highest tier must
# draw everywhere. The second pose sits one step closer.
evening_lake | pos=(45318, 64221, 42770) yaw=1790 pitch=-20
evening_lake | pos=(44902, 64396, 42783) yaw=1790 pitch=-20
# same-moby paint order: a head face cuts through Hunter's right eye under true depth; the same-moby rank paints the eye whole as the game does
sunrise_spring | pos=(86477, 47173, 22094) yaw=-713 pitch=184 | 2573
# Homeworld portal preview at 16:9: the preview opening stops short of the
# frame's stone, the inner rim draws over it, and blended water inside the
# opening draws over the preview.
sunrise_spring | pos=(25844, 47069, 20665) yaw=729 pitch=123
# The same homeworld portal seen from its back side: the preview stops short
# of the opening's top corners, and a particle draws over the preview.
sunrise_spring | pos=(24392, 51564, 21691) yaw=-690 pitch=70
# The homeworld portal turned into the 16:9 side band, outside the 4:3
# screen: the game's portal pass rejects it on the X outcode bits.
sunrise_spring | pos=(25844, 47069, 20665) yaw=256 pitch=123
# moby vs terrain depth: the submarine draws at the wrong depth against the
# ground
super_bonus_round:1 | pos=(63716, 66117, 15554) yaw=507 pitch=155
# Gem close-up: terrain lies between the gem's back and front faces. The PSX
# paints the back face over the terrain; true depth hides it, and the
# additive front face adds onto the terrain behind.
midnight_mountain | pos=(108418, 95872, 10261) yaw=-1196 pitch=205
