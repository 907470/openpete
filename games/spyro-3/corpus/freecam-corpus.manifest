# freecam-corpus.manifest - (level, pose) tuples for the Spyro 3 debug-freecam
# golden. Same row form as games/spyro-1/corpus/freecam-corpus.manifest:
#   <level>[:<area>] | pos=(x, y, z) yaw=Y pitch=P | [start]
# Each row is a reported defect; the class it belongs to is named on
# the row's comment.
# animated terrain holds its tick pose on intermediate presents
sunrise_spring | pos=(45559, 29220, 16378) yaw=1474 pitch=379
# animated terrain draws through the portal preview
sunrise_spring | pos=(26088, 46942, 20298) yaw=1150 pitch=-84
# butterfly bottles (simple kind) draw opaque
sunrise_spring | pos=(49988, 33610, 17123) yaw=1083 pitch=213
# metal vases (simple kind) draw through a wall
sunrise_spring | pos=(102255, 56733, 22972) yaw=-1891 pitch=6
# terrain depth ordering
sunny_villa | pos=(79168, 34297, 14796) yaw=867 pitch=197
# sub-level portal depth
cloud_spires | pos=(26935, 50493, 13187) yaw=-1351 pitch=84
# moby without its specular pass
cloud_spires | pos=(61927, 44074, 8510) yaw=1029 pitch=10
# locked chest without its specular pass
molten_crater | pos=(60294, 100033, 12024) yaw=791 pitch=212
# terrain depth ordering
seashell_shore | pos=(70859, 80778, 15700) yaw=-1802 pitch=222
# inside the terrain the native and guest renders differ; reporter suspects
# the back-face rule
sunrise_spring | pos=(93293, 45901, 25017) yaw=-1494 pitch=-24
# egg thief draws without its colour
midday_gardens | pos=(64750, 54918, 9705) yaw=380 pitch=207
# with interpolation the world flickers at the tick cadence; the vases behind the
# sign flicker with it (the other vase does not)
spooky_swamp | pos=(61666, 72370, 9835) yaw=167 pitch=33
# --lod extended: mobys take the extended model rule but keep the stock distance
# cull, so distant mobys vanish (the lodext tiles carry the defect)
sunrise_spring | pos=(59755, 4990, 36743) yaw=1480 pitch=354
# --lod extended: distant mobys keep the low-poly model and the distance fade
# (50 of 54 simple records low-poly at the pose; the lodext tiles carry the defect)
sunrise_spring | pos=(50900, 12500, 26900) yaw=1480 pitch=354
# Widescreen moby cull: the basket on the right of the frame is visible at
# 16:9 but is culled early; blessed pre-fix.
sunrise_spring | pos=(39482, 20225, 17997) yaw=-201 pitch=-30
# terrain texture tier: the wall's higher-quality texture repeats four times
# where the lower one drew whole; under --lod extended the highest tier must
# draw everywhere. The second pose sits one step closer.
evening_lake | pos=(45318, 64221, 42770) yaw=1790 pitch=-20
evening_lake | pos=(44902, 64396, 42783) yaw=1790 pitch=-20
# same-moby paint order: a head face cuts through Hunter's right eye under true depth; the same-moby rank paints the eye whole as the game does
sunrise_spring | pos=(86477, 47173, 22094) yaw=-713 pitch=184 | 2573
# Homeworld portal preview at 16:9: the preview opening stops short of the
# frame's stone, the inner rim draws over it, and blended water inside the
# opening draws over the preview.
sunrise_spring | pos=(25844, 47069, 20665) yaw=729 pitch=123
# The same homeworld portal seen from its back side: the preview stops short
# of the opening's top corners, and a particle draws over the preview.
sunrise_spring | pos=(24392, 51564, 21691) yaw=-690 pitch=70
# The homeworld portal turned into the 16:9 side band, outside the 4:3
# screen: the game's portal pass rejects it on the X outcode bits.
sunrise_spring | pos=(25844, 47069, 20665) yaw=256 pitch=123
# Homeworld portal seen head-on from inside its opening at 16:9: the picture is
# authored for the 4:3 frame and the side bands beyond it show the backdrop
# where the destination's own sky (Sunny Villa, read from its WAD entry) has
# faces.
sunrise_spring | pos=(26335, 48384, 20634) yaw=1422 pitch=0
# A homeworld portal beyond the pass's picture distance (depth 0x5000): the
# game draws the backdrop faded to its far colour; under --lod extended the
# picture draws at every distance.
sunrise_spring | pos=(39686, 29303, 22134) yaw=1422 pitch=40
# A homeworld portal beyond its record's draw radius (+0x40 << 10): the
# game's portal pass rejects the record before either leaf call, so
# --lod original draws neither the picture nor the far colour; under
# --lod extended the picture draws at every distance.
sunrise_spring | pos=(47634, 11245, 23996) yaw=1360 pitch=68
# moby vs terrain depth: the submarine draws at the wrong depth against the
# ground
super_bonus_round:1 | pos=(63716, 66117, 15554) yaw=507 pitch=155
# Gem close-up: terrain lies between the gem's back and front faces. The PSX
# paints the back face over the terrain; true depth hides it, and the
# additive front face adds onto the terrain behind.
midnight_mountain | pos=(108418, 95872, 10261) yaw=-1196 pitch=205
# A homeworld portal near the side edge of a 32:9 frame: the pass's depth gate
# admits a record only inside a 45-degree cone about the view axis at vertex
# 2, so a portal in the outer 32:9 band is rejected before the X outcode test.
# The 16:9 row is the contrast leg.
sunrise_spring | pos=(31890, 41448, 21584) yaw=-1993 pitch=45
sunrise_spring@aspect32x9 | pos=(31890, 41448, 21584) yaw=-1993 pitch=45 | | --aspect 32:9
# A rolled view (roll 228, about 20 degrees): the freecam stores the roll the
# game's camera builder needs for a true view roll, so the horizon tilts.
sunny_villa | pos=(79168, 34297, 14796) yaw=867 pitch=197 roll=228
# terrain ordering: LP faces in front of HP faces whose keys differ by 48-64 slots
# (the LP insert's base is 0x30 here, 0x40 in Spyro 1)
sunny_villa | pos=(79168, 34297, 23296) yaw=896 pitch=-230
# Hunter at the left edge of the 21:9 field: a large moby that stops drawing
# while its body is still inside the frame. Blessed pre-fix.
midday_gardens@aspect21x9 | pos=(45002, 68223, 11357) yaw=673 pitch=39 | | --aspect 21:9
# A panda at the left edge of the 16:9 field: its shadow stops drawing while
# the shadow is still inside the frame. Blessed pre-fix.
bamboo_terrace | pos=(81096, 78349, 17263) yaw=1054 pitch=198
# A star-animation moby in front of a sub-area portal does not draw over
# the portal surface. Blessed pre-fix.
sunny_villa | pos=(51542, 35158, 19550) yaw=-1020 pitch=35
# Sub-area door effects (class 3: opaque stars and a blended swirl) in
# front of the door's void plate: native loses them to the plate by true
# depth on these doors; the game sorts the plate behind them by its HP
# push. Blessed pre-fix.
bamboo_terrace | pos=(67021, 51211, 20056) yaw=1024 pitch=35
desert_ruins | pos=(79114, 47350, 18182) yaw=-2048 pitch=35
desert_ruins | pos=(115592, 61523, 23640) yaw=576 pitch=35
icy_peak | pos=(80284, 63461, 10860) yaw=-1136 pitch=35
icy_peak | pos=(63645, 40747, 18520) yaw=-1792 pitch=35
seashell_shore | pos=(58996, 73315, 29968) yaw=-1248 pitch=35
# Controls for the door-effect rule: a door whose effect draws today
# (plate 650 world behind), and a locked door that must stay closed.
cloud_spires | pos=(24353, 50583, 12028) yaw=-1200 pitch=35
sunny_villa | pos=(82456, 64619, 21592) yaw=-144 pitch=35
# Lava past the game's draw range stops undulating at extended LOD while
# the near lava keeps moving: a seam between near and far lava.
# Blessed pre-fix.
fireworks_factory | pos=(-18130, 83228, 13192) yaw=-78 pitch=119
# skateboard pads (patch-animated colour) flicker at the tick cadence on
# sub-tick presents under extended LOD
sunny_villa:2 | pos=(169418, 57750, 40535) yaw=1402 pitch=574
# haunted_tomb: the archway's side face shows through the wall in front of it
# (terrain key override across about 1000 world); og shows it too. Blessed pre-fix.
haunted_tomb | pos=(93215, 91480, 22144) yaw=1493 pitch=49
# fireworks_factory powerup gate: the gate's distant star particles step at the
# tick cadence; the guest's integer corners carry a placement error of up to a
# pixel that changes every tick, larger than the stars' motion.
fireworks_factory:1 | pos=(27271, 51213, 20983) yaw=-1026 pitch=7
# fireworks_factory:1, the row above with every key-pass window depth stored 4
# ulps nearer (OPENPETE_KEY_Z_ULP_BIAS=-4, the rounding a real GPU's rasteriser
# leaves in a flat key): sector 42 face 23's sub-quad keys at 29440 = 230 x 128,
# a bucket boundary; a stored value below the boundary's encoding reads as
# bucket 229 and the face loses the slot contest to its own key, a 165-pixel
# hole to the clear colour at extended LOD (NVIDIA, 2 ulps low). Blessed pre-fix.
fireworks_factory:1@keyzbias | pos=(27271, 51213, 20983) yaw=-1026 pitch=7 | | OPENPETE_KEY_Z_ULP_BIAS=-4
# --lod extended: LP faces whose corners lie on the HP mesh draw beside it as
# flat untextured stand-ins: a wedge above a mountain ridge (sector 60 LP
# faces 2-4), a sliver on the tunnel rim (sector 29 LP face 3); the
# fireworks_factory:1 row above shows the same class (sector 45 LP face 0,
# sector 42 LP face 6, sector 30 LP faces 37-38). Blessed pre-fix.
cloud_spires | pos=(78088, 77172, 11404) yaw=684 pitch=0 roll=2
lost_fleet:1 | pos=(21472, 54568, 36864) yaw=123 pitch=179 roll=-1
