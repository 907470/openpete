# carry-subtick-corpus.manifest — rows for scripts/check_carry_subtick.sh.
#
# <bk2> | <lo>-<hi> | lerps=<floor on the interpolated carry triangles>
#
# sheilas-alp: a dialogue box is on screen over VBL 4361-4377 and the 2D feed
# inserts one primitive into the middle of the set at 4375 while the total
# count is unchanged, which is the composition change an index pairing cannot
# see. The box's four corner quads are the same 12x8 quad, the top and bottom
# pair 58 px apart.
sheilas-alp-sheila-water-invisible.bk2 | 4025-4045 | lerps=600
sheilas-alp-sheila-water-invisible.bk2 | 4361-4381 | lerps=3000
#
# The 4025-4045 span is the same box sliding off screen at up to 64 px/tick
# while the HUD reuses one primitive slot for a different glyph: the slide must
# still interpolate and the reuse must not.
