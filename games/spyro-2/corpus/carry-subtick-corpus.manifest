# carry-subtick-corpus.manifest - rows for tests/harness/check_carry_subtick.sh.
#
# <bk2> | <lo>-<hi> | lerps=<floor on the interpolated carry triangles>
#
# glimmer: the same dialogue-box construction in a game whose semi-transparent
# 2D population does not change composition tick to tick - the negative the
# Spyro 3 row is read against.
glimmer-pogo-dialogue.bk2 | 1568-1588 | lerps=300
#
# open-guidebook: the guidebook page builds its 2D from a different count each
# tick (556 entries against 476 at VBL 1552), so the pairing must hold every
# element of the repeated 16x40 column still; the presentation golden's
# intermediate tile at 1553 is that present.
open-guidebook.bk2 | 1548-1558 | lerps=3000
#
# attract-demo: no movie, the plain boot. The DEMO MODE box is five untextured
# bars at y = 194, 195, 196, 205, 206, static across the brackets; the tile at
# 17473 is the present at VBL 17474.
attract-demo | 17468-17478 | lerps=100
#
# autumn-plains-skelos-badlands-portal-entry: the "Treasure Found" banner
# scrolls while the rest of the 2D stands still, and the whole capture is one
# run of 56 entries, 28 static HUD and 28 banner, two contiguous bodies that
# displace by different amounts. The row holds the mixed-displacement case: the
# run must split into its two contiguous segments and carry each by its own
# translation (one translation for the whole run snaps the banner; pairing by
# identity tears a word), so `segs` floors the segmentation path's engagement
# and `disagree=0` refuses a run that finds no translation at all.
autumn-plains-skelos-badlands-portal-entry.bk2 | 1918-1928 | lerps=900 segs=60 disagree=0
#
# glimmer-pogo-dialogue 1468-1478: the dialogue panel glides in from the edge,
# and its body is repeated identical tiles - no tile is distinguishable from
# its siblings, so only the run's rigid translation carries them. The panel is
# three runs of 20 triangles per present, 660 over the row's 33 presents; the
# cutscene letterbox bars are drawn by the native letterbox pass, not carried.
glimmer-pogo-dialogue.bk2 | 1468-1478 | lerps=620
