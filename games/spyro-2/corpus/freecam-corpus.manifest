# freecam-corpus.manifest, (level, pose) tuples for the Spyro 2 debug-freecam
# golden. Same row form as games/spyro-1/corpus/freecam-corpus.manifest:
#   <level> | pos=(x, y, z) yaw=Y pitch=P | [start]
#
# Coverage rows, one per two levels of the game's 29: the terrain feeder reads
# each level's own sector, face and texture data, so a level that no row
# reaches is a decode surface the golden cannot see. Each pose is the level's
# own follow camera, read off game_layout.cam at the tick the free camera
# engages -- the tick that also freezes the player, so the pose frames the
# player exactly as the game framed him and every row carries the player
# feeder as well as the terrain one. A pose taken later in the run would not:
# the free camera freezes the player where it engages, and on the flight
# levels (metro_speedway, canyon_speedway) the follow camera has travelled
# thousands of units by the capture frame.
# A row placed by a reported defect carries that defect on its comment. It
# replaces the coverage row for its level only when it frames at least the
# feeders the coverage row does; otherwise both rows stay.
summer_forest | pos=(130413, 15471, 38359) yaw=1088 pitch=160
# Sub-tick row: one moby of the second model kind (class 0x71) that moves 35
# units and turns 11.25 degrees per tick, with no animated moby in view, so
# the intermediate leg carries the second kind's own motion and nothing else.
summer_forest | pos=(52127, 49180, 45249) yaw=-946 pitch=303
idol_springs | pos=(115428, 98127, 14292) yaw=-1135 pitch=160
# The row that carries the moby special-material treatments: its mobys draw
# faces under both the bit-5 dispatcher's mode 0 and its mode 2, so a change
# to either treatment moves this tile. summer_forest carries mode 0 alone.
hurricos | pos=(19757, 33954, 15316) yaw=496 pitch=160
sunny_beach | pos=(72260, 16288, 26067) yaw=1936 pitch=160
# crushs_dungeon also holds the boss HUD at the bottom left: the icon above
# the health bar draws as a black silhouette on both the native path and the
# reference, so the tile, not the reference, carries the change that fixes it.
crushs_dungeon | pos=(24218, 29700, 11221) yaw=96 pitch=160
skelos_badlands | pos=(54371, 53353, 26580) yaw=400 pitch=160
breeze_harbor | pos=(83855, 83763, 11221) yaw=-433 pitch=160
metro_speedway | pos=(140182, 62755, 17920) yaw=1551 pitch=0
shady_oasis | pos=(47104, 25331, 5217) yaw=1024 pitch=160
fracture_hills | pos=(123263, 72199, 34629) yaw=-672 pitch=160
gulps_overlook | pos=(36864, 51634, 18901) yaw=-1024 pitch=158
mystic_marsh | pos=(112622, 35105, 9155) yaw=1648 pitch=160
canyon_speedway | pos=(66451, 83321, 27812) yaw=1839 pitch=0
metropolis | pos=(115904, 59478, 40916) yaw=1696 pitch=160
riptos_arena | pos=(44103, 72307, 8612) yaw=-1040 pitch=160
# retained terrain face at a bucket-boundary key loses the contest to itself (hardware only; the windowed cache-off/on harness separates the builds)
glimmer | pos=(55630, 29629, 25462) yaw=974 pitch=243
# --lod extended: animated-kind mobys (eggs, enemies) outside the cull's
# distance box are not revealed; the simple kind is (the lodext tiles carry
# the defect)
glimmer | pos=(83331, 23551, 43211) yaw=1636 pitch=448
# The two poses that frame a homeworld portal preview: the game's own follow
# camera at the tick the portal pass first previews two portals, so each row
# carries the portal feeder as well as the terrain and player ones. Summer
# Forest's coverage row above frames none, and no other row in this file
# reaches a portal pass that draws.
autumn_plains | pos=(90130, 56523, 28297) yaw=1024 pitch=160
winter_tundra | pos=(51217, 30497, 40037) yaw=752 pitch=160
# Widescreen moby cull: the basket on the right of the frame is visible at
# 16:9 on the PSX-projected view but is culled by the host reveal (user
# report 2026-09-19); blessed pre-fix.
glimmer | pos=(68754, 34233, 13267) yaw=215 pitch=12
# Near/HQ tier UV orientation: the pose stands close enough to the surface for
# the 2x2 subdivide, and its sub-tiles carry non-identity orientation indices,
# so every mirrored or rotated HQ quadrant in the frame moves when the
# orientation table is read or left unread.
metropolis | pos=(115218, 59889, 40916) yaw=1696 pitch=160
