# freecam-corpus.manifest, (level, pose) tuples for the Spyro 2 debug-freecam
# golden. Same row form as games/spyro-1/corpus/freecam-corpus.manifest:
#   <level> | pos=(x, y, z) yaw=Y pitch=P | [start]
#
# Coverage rows, one per two levels of the game's 29: the terrain feeder reads
# each level's own sector, face and texture data, so a level that no row
# reaches is a decode surface the golden cannot see. Each pose is the level's
# own follow camera, read off game_layout.cam at the tick the free camera
# engages -- the tick that also freezes the player, so the pose frames the
# player exactly as the game framed him and every row carries the player
# feeder as well as the terrain one. A pose taken later in the run would not:
# the free camera freezes the player where it engages, and on the flight
# levels (metro_speedway, canyon_speedway) the follow camera has travelled
# thousands of units by the capture frame.
# A row placed by a reported defect carries that defect on its comment. It
# replaces the coverage row for its level only when it frames at least the
# feeders the coverage row does; otherwise both rows stay.
summer_forest | pos=(130413, 15471, 38359) yaw=1088 pitch=160
# Sub-tick row: one moby of the second model kind (class 0x71) that moves 35
# units and turns 11.25 degrees per tick, with no animated moby in view, so
# the intermediate leg carries the second kind's own motion and nothing else.
summer_forest | pos=(52127, 49180, 45249) yaw=-946 pitch=303
idol_springs | pos=(115428, 98127, 14292) yaw=-1135 pitch=160
# The row that carries the moby special-material treatments: its mobys draw
# faces under both the bit-5 dispatcher's mode 0 and its mode 2, so a change
# to either treatment moves this tile. summer_forest carries mode 0 alone.
hurricos | pos=(19757, 33954, 15316) yaw=496 pitch=160
sunny_beach | pos=(72260, 16288, 26067) yaw=1936 pitch=160
# crushs_dungeon also holds the boss HUD at the bottom left: the icon above
# the health bar draws as a black silhouette on both the native path and the
# reference, so the tile, not the reference, carries the change that fixes it.
crushs_dungeon | pos=(24218, 29700, 11221) yaw=96 pitch=160
skelos_badlands | pos=(54371, 53353, 26580) yaw=400 pitch=160
breeze_harbor | pos=(83855, 83763, 11221) yaw=-433 pitch=160
metro_speedway | pos=(140182, 62755, 17920) yaw=1551 pitch=0
shady_oasis | pos=(47104, 25331, 5217) yaw=1024 pitch=160
fracture_hills | pos=(123263, 72199, 34629) yaw=-672 pitch=160
gulps_overlook | pos=(36864, 51634, 18901) yaw=-1024 pitch=158
mystic_marsh | pos=(112622, 35105, 9155) yaw=1648 pitch=160
canyon_speedway | pos=(66451, 83321, 27812) yaw=1839 pitch=0
metropolis | pos=(115904, 59478, 40916) yaw=1696 pitch=160
riptos_arena | pos=(44103, 72307, 8612) yaw=-1040 pitch=160
# The same pose with the canonical leg at 2523, while Ripto's dialogue box
# shows its continue arrow: the arrow's fill, a glyph the game feeds at
# emission, draws over the box's translucent corner piece, a quad of the
# batch released after the world, at full brightness, as the guest
# reference draws it; blessed pre-fix with the corner over the arrow.
riptos_arena@arrow | pos=(44103, 72307, 8612) yaw=-1040 pitch=160 | 2523
# retained terrain face at a bucket-boundary key loses the contest to itself (hardware only; the windowed cache-off/on harness separates the builds)
glimmer | pos=(55630, 29629, 25462) yaw=974 pitch=243
# --lod extended: animated-kind mobys (eggs, enemies) outside the cull's
# distance box are not revealed; the simple kind is (the lodext tiles carry
# the defect)
glimmer | pos=(83331, 23551, 43211) yaw=1636 pitch=448
# The two poses that frame a homeworld portal preview: the game's own follow
# camera at the tick the portal pass first previews two portals, so each row
# carries the portal feeder as well as the terrain and player ones. Summer
# Forest's coverage row above frames none, and no other row in this file
# reaches a portal pass that draws.
autumn_plains | pos=(90130, 56523, 28297) yaw=1024 pitch=160
winter_tundra | pos=(51217, 30497, 40037) yaw=752 pitch=160
# Widescreen moby cull: the basket on the right of the frame is visible at
# 16:9 on the PSX-projected view but is culled by the host reveal; blessed
# pre-fix.
glimmer | pos=(68754, 34233, 13267) yaw=215 pitch=12
# Near/HQ tier UV orientation: the pose stands close enough to the surface for
# the 2x2 subdivide, and its sub-tiles carry non-identity orientation indices,
# so every mirrored or rotated HQ quadrant in the frame moves when the
# orientation table is read or left unread.
metropolis | pos=(115218, 59889, 40916) yaw=1696 pitch=160
# Homeworld portal preview at 16:9: the preview opening is cut from the
# portal record and stops short of the frame's stone in the side bands, and
# blended water inside the opening draws over the preview.
summer_forest | pos=(119874, 78997, 37176) yaw=-1789 pitch=111
# Homeworld portal preview leaves the top corners of the arch uncovered:
# the world behind shows in two triangles between the preview and the stone.
summer_forest | pos=(121674, 76726, 37488) yaw=1556 pitch=-40
# A homeworld portal whose pentagon projects inside the 16:9 side band but
# outside the 4:3 screen: the game's portal pass rejects it on the X
# outcode bits, so its preview is missing at 16:9.
autumn_plains | pos=(90130, 56523, 28297) yaw=688 pitch=160
# Homeworld portal seen head-on from inside its opening at 16:9: the picture is
# authored for the 4:3 frame and the side bands beyond it show the backdrop
# where the destination's own sky (Colossus, read from its WAD entry) has faces.
summer_forest | pos=(92227, 83198, 37023) yaw=2167 pitch=0
# A homeworld portal beyond the pass's picture distance (depth 0x5000): the
# game draws the backdrop faded to its far colour; under --lod extended the
# picture draws at every distance.
summer_forest | pos=(117352, 87841, 38523) yaw=2167 pitch=40
# A homeworld portal beyond its record's draw radius (+0x40 << 10): the
# game's portal pass rejects the record before either leaf call, so
# --lod original draws neither the picture nor the far colour; under
# --lod extended the picture draws at every distance.
autumn_plains | pos=(89729, 42806, 34729) yaw=1009 pitch=113
# zephyr poly-anim sector 114: far away the guest re-packs only the LP bank,
# so --lod extended draws the stale HP pose and the uncovered-LP ride adds
# the current LP pose, two copies of the object (863 px over HP); original
# and the guest reference show one.
zephyr | pos=(188848, 40008, 31664) yaw=1707 pitch=156
# sunny_beach sector 28: LP faces 1, 2, 5, 7, 12 and 14 draw a standing slab
# natively in both LOD modes (1648 px) that the guest's LP near outcode
# drops (every corner SZ under the sector's near threshold).
sunny_beach | pos=(30097, 21908, 44979) yaw=523 pitch=226
# Gem close-up: terrain lies between the gem's back and front faces. The PSX
# paints the back face over the terrain; true depth hides it, and the
# additive front face adds onto the terrain behind.
winter_tundra | pos=(62261, 102618, 45966) yaw=-7 pitch=143
# A homeworld portal near the side edge of a 32:9 frame: the pass's depth gate
# admits a record only inside a 45-degree cone about the view axis at vertex
# 2, so a portal in the outer 32:9 band is rejected before the X outcode test.
# The 16:9 row is the contrast leg.
summer_forest | pos=(106616, 79875, 36925) yaw=-1522 pitch=154
summer_forest@aspect32x9 | pos=(106616, 79875, 36925) yaw=-1522 pitch=154 | | --aspect 32:9
# The cone-widened band admits a far portal whose outline overlaps the near
# arch; the near inner rim must hold inside the far outline.
summer_forest@aspect32x9 | pos=(106616, 79875, 36925) yaw=-1650 pitch=154 | | --aspect 32:9
# A rolled view (roll 228, about 20 degrees): the freecam stores the roll the
# game's camera builder needs for a true view roll, so the horizon tilts.
glimmer | pos=(55630, 29629, 25462) yaw=974 pitch=243 roll=-228
# A wall moby (55 triangles) standing on a floor sector: the game keys each
# moby face once into its record's local bucket array and splices that array
# into the world ordering table below the floor's bucket, so the wall paints
# over the floor; a per-triangle key ties the floor's bucket and a 733-px
# floor wedge draws over the wall's bottom edge. Blessed pre-fix.
fracture_hills | pos=(160297, 144885, 34144) yaw=1543 pitch=112
# The Earthshaper at the right edge of the 16:9 field: a large moby that
# stops drawing while its body is still inside the frame. Blessed pre-fix.
fracture_hills | pos=(111293, 143960, 32528) yaw=-450 pitch=66
# A Bonebuilder at the left edge of the 16:9 field: its shadow stops drawing
# while the shadow is still inside the frame. Blessed pre-fix.
skelos_badlands | pos=(79872, 75897, 31120) yaw=164 pitch=188
# Two gems resting on a stone step: the step's near lip paints over their
# lower halves (native and the ordering-table reference alike) although
# the gems sit on top of it. Blessed pre-fix.
glimmer | pos=(37180, 45817, 12643) yaw=-59 pitch=238
# Lava past the game's draw range stops undulating at extended LOD while
# the near lava keeps moving: a seam between near and far lava.
# Blessed pre-fix.
magma_cone | pos=(93407, 88746, 41508) yaw=-1999 pitch=236
# Lava in Crush's Dungeon from near to far: the far lava stops undulating
# at extended LOD. Blessed pre-fix.
crushs_dungeon | pos=(-1501, 29835, 47171) yaw=17 pitch=563
# Crush's Dungeon lava ring split half near (animated) and half far
# (frozen at extended LOD). Blessed pre-fix.
crushs_dungeon | pos=(3080, 30039, 31217) yaw=29 pitch=548
# A whirlwind of particle-pool records (classes 1 and 3) in the left 16:9
# band: the particle routine stamps and appends a record only inside the 4:3
# window (x in (0, 512)), so the band showed none of them. The player pose
# places Spyro where the emitter spawns them. Blessed pre-fix.
glimmer | pos=(94737, 111480, 10196) yaw=-1053 pitch=-72 | | --player-pose pos=(94780,109001,9575)
# a life orb's (class 0x71) star hidden over half its area by the orb's own
# faces (the star took its pool record's view-Z, the orb's origin); the player
# placed beside the orb. Blessed pre-fix.
summer_forest@glintdepth | pos=(51616, 47022, 44485) yaw=0 pitch=224 | 1467 | --player-pose 52316,48800,44300,1024
# Water under extended LOD on a fog level: the water surface draws near-white
# with a dark lattice and no per-pixel fog, where original LOD fogs it.
mystic_marsh | pos=(83131, 19147, 32066) yaw=1043 pitch=506
