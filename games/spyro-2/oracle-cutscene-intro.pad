# Spyro 2 reference drive from boot through the intro cutscene, for
# scripts/capture_psx_oracle_ds.sh --recipe games/spyro-2/oracle-cutscene-intro.conf.
# Every step waits on the top-level state word D_800681C8 (0x800681C8:
# 5 cutscene start, 6 playback), so drive-timed loads do not move a press.
# Cross held 6 of every 60 VBLs passes the logos, the title and the new-game menu.
mash cross 6 60 until w:0x800681C8 eq 5
until w:0x800681C8 eq 6
until w:0x800681C8 ne 6
wait 120
quit
