// Windows resources of an OpenPete executable (@_rc_image@.exe): the
// one executable that runs every linked game, or a per-game executable.
// Configured by CMake (icon path, manifest path, file name, version).
// VERSIONINFO matters beyond cosmetics: an exe with no version metadata
// reads as illegitimate to SmartScreen/AV heuristics and shows an empty
// Properties->Details pane; it is also where a future Authenticode signing
// step expects sane fields.
1 ICON "@_rc_icon@"

// Application manifest (RT_MANIFEST = 24): UTF-8 active code page,
// long-path awareness, Windows 10/11 supportedOS, asInvoker.
1 24 "@_rc_manifest@"

1 VERSIONINFO
FILEVERSION     @OPENPETE_VERSION_NUM@
PRODUCTVERSION  @OPENPETE_VERSION_NUM@
FILEOS          0x40004L
FILETYPE        0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName",      "OpenPete"
      VALUE "FileDescription",  "OpenPete"
      VALUE "CompanyName",      "OpenPete project"
      VALUE "InternalName",     "@_rc_image@"
      VALUE "OriginalFilename", "@_rc_image@.exe"
      VALUE "FileVersion",      "@OPENPETE_VERSION_STR@"
      VALUE "ProductVersion",   "@OPENPETE_VERSION_STR@"
      VALUE "LegalCopyright",   "(c) OpenPete contributors. Not affiliated with Sony, Insomniac Games, or Activision."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
