# Generate a C source that embeds the compiled SPIR-V shader blobs plus a
# name->blob lookup table, so the native renderer ships as a self-contained
# binary (no loose shaders/ dir). Pure CMake (file(READ ... HEX)) — no bin2c
# or xxd host dependency, identical for native and cross builds.
#
# Run at BUILD time via `cmake -P`, after glslangValidator has produced the
# .spv (it DEPENDS on them). Inputs (passed with -D):
#   SPV_LIST  '|'-separated list of full .spv paths (| avoids the ';' that
#             a CMake list would split into separate -D arguments)
#   OUT_C     output .c path
#
# The generated table is consumed via rhi_embedded_shaders.h.

string(REPLACE "|" ";" SPV_LIST "${SPV_LIST}")

set(_body "/* AUTO-GENERATED by embed_shaders.cmake — do not edit. */\n")
string(APPEND _body "#include \"rhi_embedded_shaders.h\"\n\n")

set(_table "")
foreach(_spv IN LISTS SPV_LIST)
    get_filename_component(_name "${_spv}" NAME)        # quad.vert.spv
    string(MAKE_C_IDENTIFIER "${_name}" _sym)           # quad_vert_spv
    file(READ "${_spv}" _hex HEX)
    string(LENGTH "${_hex}" _hexlen)
    math(EXPR _bytes "${_hexlen} / 2")
    # "abcd..." -> list of "0xab;0xcd;..." then emit 16 per line. (CMake's
    # regex has no {n} interval quantifier, so chunk via list ops, not regex —
    # keeps the generated lines short for readable diffs.)
    string(REGEX MATCHALL ".." _hbytes "${_hex}")
    list(TRANSFORM _hbytes PREPEND "0x")
    list(LENGTH _hbytes _nbytes)
    set(_arr "")
    set(_i 0)
    while(_i LESS _nbytes)
        math(EXPR _rem "${_nbytes} - ${_i}")
        if(_rem GREATER 16)
            set(_take 16)
        else()
            set(_take ${_rem})
        endif()
        list(SUBLIST _hbytes ${_i} ${_take} _row)
        list(JOIN _row "," _rowstr)
        string(APPEND _arr "    ${_rowstr},\n")
        math(EXPR _i "${_i} + ${_take}")
    endwhile()
    string(APPEND _body "static const unsigned char s_${_sym}[] = {\n${_arr}};\n")
    string(APPEND _table "    { \"${_name}\", s_${_sym}, ${_bytes}u },\n")
endforeach()

string(APPEND _body "\nconst rhi_embedded_shader g_rhi_embedded_shaders[] = {\n${_table}};\n")
string(APPEND _body "const unsigned g_rhi_embedded_shader_count =\n")
string(APPEND _body "    (unsigned)(sizeof(g_rhi_embedded_shaders) / sizeof(g_rhi_embedded_shaders[0]));\n")

file(WRITE "${OUT_C}" "${_body}")
