/* @OPENPETE_SDK_DISPATCH_HEADER@ - selects the per-game @OPENPETE_SDK_DISPATCH_HEADER@.
 *
 * Generated by the engine build from core/mods/sdk/openpete_sdk_dispatch.h.in;
 * do not edit.
 *
 * The per-game headers live in sdk/games/<game>/. A compile line that puts
 * -I sdk/games/<game> before -I sdk resolves this name there and never
 * opens this file. A line with -I sdk alone reaches this file, which
 * includes games/spyro-1/@OPENPETE_SDK_DISPATCH_HEADER@ when OPENPETE_GAME_ID
 * is undefined or OPENPETE_GAME_SPYRO1 is 1, and games/spyro-2/ or
 * games/spyro-3/ when OPENPETE_GAME_SPYRO2 or OPENPETE_GAME_SPYRO3 is 1.
 * A packaged SDK carries one game's directory; an arm whose directory is
 * absent stops the compile with #error naming the game. */

#ifdef OPENPETE_MOD_ANY_GAME
#error "@OPENPETE_SDK_DISPATCH_HEADER@ is per-game; an OPENPETE_MOD_ANY_GAME object reads no per-game header"
#elif !defined(OPENPETE_GAME_ID) || (defined(OPENPETE_GAME_SPYRO1) && OPENPETE_GAME_SPYRO1)
#if __has_include("games/spyro-1/@OPENPETE_SDK_DISPATCH_HEADER@")
#include "games/spyro-1/@OPENPETE_SDK_DISPATCH_HEADER@"
#else
#error "@OPENPETE_SDK_DISPATCH_HEADER@: this SDK has no Spyro 1 headers (sdk/games/spyro-1/ is absent); a line with -I sdk alone selects Spyro 1, so put -I sdk/games/<game> before -I sdk"
#endif
#elif defined(OPENPETE_GAME_SPYRO2) && OPENPETE_GAME_SPYRO2
#if __has_include("games/spyro-2/@OPENPETE_SDK_DISPATCH_HEADER@")
#include "games/spyro-2/@OPENPETE_SDK_DISPATCH_HEADER@"
#else
#error "@OPENPETE_SDK_DISPATCH_HEADER@: this SDK has no Spyro 2 headers (sdk/games/spyro-2/ is absent); build against the SDK of a Spyro 2 package"
#endif
#elif defined(OPENPETE_GAME_SPYRO3) && OPENPETE_GAME_SPYRO3
#if __has_include("games/spyro-3/@OPENPETE_SDK_DISPATCH_HEADER@")
#include "games/spyro-3/@OPENPETE_SDK_DISPATCH_HEADER@"
#else
#error "@OPENPETE_SDK_DISPATCH_HEADER@: this SDK has no Spyro 3 headers (sdk/games/spyro-3/ is absent); build against the SDK of a Spyro 3 package"
#endif
#else
#error "@OPENPETE_SDK_DISPATCH_HEADER@: OPENPETE_GAME_ID is defined and no OPENPETE_GAME_SPYRO1/2/3 is 1"
#endif
